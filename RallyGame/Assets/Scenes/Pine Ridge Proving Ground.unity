  m_EditorClassIdentifier: Assembly-CSharp::PineRidgeTestSession
  car: {fileID: 458419419}
  chaseCamera: {fileID: 111961112}
  hub: {fileID: 1169896353}
  stations:
  - name: Brakes
    instructions: Build speed and brake at the amber line. The panel records your stopping distance.
    spawn: {fileID: 1317958625}
  - name: Suspension
    instructions: "Start at 25\u201340 km/h. Compare both sides over the ribs and alternating bumps."
    spawn: {fileID: 1045223461}
  - name: Jump
    instructions: "Aim for 50\u201370 km/h at the lip. Hold the center and watch the airtime readout."
    spawn: {fileID: 1910415209}
  - name: Slalom
    instructions: "Weave around the cones at 35\u201355 km/h. Watch for rear slip as you change direction."
    spawn: {fileID: 553998199}
  - name: Hairpin
    instructions: "Slow to 20\u201335 km/h for the right hairpin, then accelerate out onto the return lane."
    spawn: {fileID: 1074136724}
  - name: Hill and Camber
    instructions: Try a standing start on the climb, then brake over the crest and cross the tilted section.
    spawn: {fileID: 1002347636}
  wheels:
  - {fileID: 593433800}
  - {fileID: 520477245}
  - {fileID: 1240029987}
  - {fileID: 181805620}
